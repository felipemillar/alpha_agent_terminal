# Alpha Agent Terminal — Variables de Entorno
# Copia este archivo como .env y completa los valores.
#
#   cp .env.example .env

# API Key de Google Gemini (requerida para los reportes del agente IA)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Puerto del servidor HTTP (opcional, por defecto 8050)
# SERVER_PORT=8050
