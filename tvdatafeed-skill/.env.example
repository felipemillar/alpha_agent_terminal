# ========================================
# Configuración del proyecto tvdatafeed
# ========================================

# --- Credenciales de TradingView (opcional, suele fallar por CAPTCHA) ---
TV_USERNAME=
TV_PASSWORD=

# --- Token de sesión ---
# Opciones:
#   1. Dejar en blanco → el sistema extraerá la cookie automáticamente del navegador.
#   2. Pegar tu sessionid (cadena corta ~25 chars) → se canjeará por JWT automáticamente.
#   3. Pegar el JWT completo (cadena larga ~1000+ chars) → se usará directamente.
TV_AUTH_TOKEN=ESTE_ES_TU_TOKEN

# --- Entorno de ejecución ---
# dev (default): busca cookies en navegadores locales.
# prod/staging/ci: omite la extracción de cookies (requiere JWT manual).
ENV=dev

# --- Nivel de logging ---
# DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Cache de JWT ---
# Tiempo de vida del token cacheado en horas (default: 6)
CACHE_TTL_HOURS=6
