# Python
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Environment secrets
.env

# Token caches and credentials
**/.token_cache.json

# OS files
.DS_Store
Thumbs.db

# IDE / Agent local config
# (agent rules should be version controlled, so we don't ignore .agents/)

# Logs
*.log

# pytest
.pytest_cache/

# Bridge runtime data (generated by the server at runtime)
bridge/antigravity_bridge_request.json
bridge/antigravity_bridge_response.json
bridge/estado_dashboard.json

# Data files (Best Practice: Never commit raw data)
data/
*.csv

# Excepciones: Activos permitidos para subir a GitHub
!data/
!data/USDCLP_historico.csv
